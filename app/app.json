{
  "expo": {
    "name": "Morning Brief",
    "slug": "morning-brief",
    "version": "1.0.0",
    "scheme": "morningbrief",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1c1e"
    },
    "ios": {
      "bundleIdentifier": "io.github.narekpd1994.morningbrief",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.narekpd1994.morningbrief",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#1c1c1e"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Morning Brief uses your photos only when you choose a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}